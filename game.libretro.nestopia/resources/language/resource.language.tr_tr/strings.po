msgctxt "#30095"
msgid "Input"
msgstr "Girdi"

msgctxt "#30096"
msgid "Change input devices and other input related settings."
msgstr "Girdi cihazlarını ve girdilerle ilgili diğer ayarları değiştirin."

msgctxt "#30097"
msgid "Manually select a 4 Player Adapter if needed. Some games will not recognize the adapter correctly through the NstDatabase.xml database, this option should help fix that."
msgstr "Gerekirse el ile bir 4 Oyuncu Adaptörü seçin. Bazı oyunlar bağdaştırıcıyı NstDatabase.xml veritabanı ile doğru bir şekilde tanıyamayabilir, bu seçenek bunu düzeltmeye yardımcı olur."

msgctxt "#30098"
msgid "Rotate the A/B/X/Y buttons clockwise."
msgstr "A/B/X/Y düğmelerini saat yönünde çevirin."

msgctxt "#30099"
msgid "Select the device you wish to use for the Arkanoid paddle."
msgstr "Arkanoid kürek için kullanmak istediğiniz cihazı seçin."

msgctxt "#30100"
msgid "Mouse"
msgstr "Fare"

msgctxt "#30101"
msgid "Pointer"
msgstr "İşaretçi"

msgctxt "#30102"
msgid "Set the range for the Arkanoid paddle."
msgstr "Arkanoid paddle için aralığı ayarlayın."

msgctxt "#30103"
msgid "Combined range of both controllers (32-166)"
msgstr "Her iki kontrolörün birleşik aralığı (32-166)"

msgctxt "#30104"
msgid "Arkanoid I controller range (46-166)"
msgstr "Arkanoid I kontrolör aralığı (46-166)"

msgctxt "#30105"
msgid "Arkanoid II controller range (32-153)"
msgstr "Arkanoid II kontrolör aralığı (32-153)"

msgctxt "#30106"
