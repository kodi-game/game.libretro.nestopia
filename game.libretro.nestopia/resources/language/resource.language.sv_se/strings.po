msgid "Set the range for the Arkanoid paddle."
msgstr "Ställ in intervallet för Arkonoid-paddeln."

msgctxt "#30103"
msgid "Combined range of both controllers (32-166)"
msgstr "Kombinerat intervall för båda kontrollerna (32-166)"

msgctxt "#30104"
msgid "Arkanoid I controller range (46-166)"
msgstr "Intervall för Arkanoid I-kontroller (46-166)"

