msgctxt "#30096"
msgid "Change input devices and other input related settings."
msgstr "Ändra inmatningsenheter och andra ingångsrelaterade inställningar."

msgctxt "#30097"
msgid "Manually select a 4 Player Adapter if needed. Some games will not recognize the adapter correctly through the NstDatabase.xml database, this option should help fix that."
msgstr "Välj manuellt en 4-spelaradapter om det behövs. Vissa spel kommer inte att känna igen adaptern korrekt genom NstDatabase.xml databasen, den här inställningen bör hjälpa till att lösa det."

msgctxt "#30098"
msgid "Rotate the A/B/X/Y buttons clockwise."
msgstr "Rotera A/B/X/Y-knapparna medsols."

msgctxt "#30099"
msgid "Select the device you wish to use for the Arkanoid paddle."
msgstr "Välj den enhet du vill använda för Arkanoid-paddeln."

