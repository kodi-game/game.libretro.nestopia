msgctxt "#30074"
msgid "Mask out (vertically) the potentially random glitchy video output that would have been hidden by the bezel around the edge of a standard-definition television screen."
msgstr "Oculta (verticalmente) a saída de vídeo com defeito aleatório que seria escondida pela moldura ao redor de uma tela de televisão padrão."

msgctxt "#30075"
msgid "Mask out (horizontally) the potentially random glitchy video output that would have been hidden by the bezel around the edge of a standard-definition television screen."
msgstr "Oculta (horizontalmente) a saída de vídeo com defeito aleatório que seria escondida pela moldura ao redor de uma tela de televisão padrão."

msgctxt "#30076"
msgid "RetroArch's aspect ratio must be set to 'Core Provided' in the Video settings. 'Auto' will use the NstDatabase.xml database file for aspect ratio autodetection. If there is no database present, it will default to NTSC."
msgstr ""

msgctxt "#30077"
msgid "4:3"
msgstr ""

msgctxt "#30078"
msgid "Uncorrected"
msgstr "Não corrigida"

msgctxt "#30079"
msgid "Audio"
msgstr "Áudio"

msgctxt "#30080"
msgid "Change audio effects and channel volumes."
msgstr "Altera os volumes dos canais e efeitos de áudio."

msgctxt "#30081"
msgid "The Game Genie cheat device could inadvertently introduce sound distortion in games. By enabling this, you can simulate the distortion it would add to a game's sound."
msgstr "O dispositivo Game Genie pode causar acidentalmente uma distorção de áudio nos jogos. Ao ativar esta opção, você pode simular a distorção."

msgctxt "#30082"
msgid "Enable configuration of low-level audio channel parameters."
msgstr "Habilita a configuração dos parâmetros de baixo nível do canal de áudio."

msgctxt "#30083"
msgid "Modify Square 1 Channel Volume %."
msgstr "Altera o volume do canal de ondas quadradas 1 (em porcentagem)."

msgctxt "#30084"
msgid "Modify Square 2 Channel Volume %."
msgstr "Altera o volume do canal de ondas quadradas 2 (em porcentagem)."

msgctxt "#30085"
msgid "Modify Triangle Channel Volume %."
msgstr "Altera o volume do canal de ondas triangulares (em porcentagem)."

msgctxt "#30086"
msgid "Modify Noise Channel Volume %."
msgstr "Altera o volume do canal de ruído (em porcentagem)."

msgctxt "#30087"
