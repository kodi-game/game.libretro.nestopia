msgstr "FBX 平滑版 V2"

msgctxt "#30066"
msgid "Composite Direct FBX"
msgstr "FBX 复合直连"

msgctxt "#30067"
msgid "PVM-style D93 FBX"
msgstr "FBX PVM 风格（色温 D93） "

msgctxt "#30068"
msgid "NTSC hardware FBX"
msgstr "FBX NTSC 硬件实拍"

msgctxt "#30069"
msgid "NES Classic FBx (fixed)"
msgstr "FBX NES Classic 版（固定调色板）"

msgctxt "#30070"
msgid "Restored Wii VC"
msgstr "修复版 Wii 虚拟主机"

msgctxt "#30071"
