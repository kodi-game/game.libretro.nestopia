msgctxt "#30095"
msgid "Input"
msgstr "Vstup"

msgctxt "#30096"
msgid "Change input devices and other input related settings."
msgstr "Zmeňte vstupné zariadenia a ďalšie nastavenia týkajúce sa vstupu."

msgctxt "#30097"
msgid "Manually select a 4 Player Adapter if needed. Some games will not recognize the adapter correctly through the NstDatabase.xml database, this option should help fix that."
msgstr "Manuálne vyberte adaptér pre 4 hráčov, ak je to potrebné. Niektoré hry adaptér správne nerozpoznajú cez databázu NstDatabase.xml, táto možnosť by to mala pomôcť opraviť."

msgctxt "#30098"
msgid "Rotate the A/B/X/Y buttons clockwise."
msgstr "Otočiť tlačidlá A/B/X/Y v smere hodinových ručičiek."

msgctxt "#30099"
msgid "Select the device you wish to use for the Arkanoid paddle."
msgstr "Vyberte zariadenie, ktoré chcete použiť pre Arkanoid paddle."

