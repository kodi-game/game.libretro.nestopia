msgid "Mouse"
msgstr "Myš"

msgctxt "#30101"
msgid "Pointer"
msgstr "Ukazovateľ"

msgctxt "#30102"
msgid "Set the range for the Arkanoid paddle."
msgstr "Nastaví rozsah pre Arkanoid paddle."

msgctxt "#30103"
msgid "Combined range of both controllers (32-166)"
msgstr "Kombinovaný rozsah oboch ovládačov (32-166)"

msgctxt "#30104"
msgid "Arkanoid I controller range (46-166)"
msgstr "Rozsah ovládača Arkanoid I (46-166)"

msgctxt "#30105"
msgid "Arkanoid II controller range (32-153)"
msgstr "Rozsah ovládača Arkanoid II (32-153)"

msgctxt "#30106"
msgid "Select the device you wish to use for the Zapper."
msgstr "Vyberte zariadenie, ktoré chcete použiť pre Zapper."

msgctxt "#30107"
msgid "Light gun"
msgstr "Svetelná pištoľ"

msgctxt "#30108"
msgid "Set whether to show the crosshair when the Zapper is used."
msgstr "Nastaví, či zobrazovať zameriavač pri použití Zapperu."

msgctxt "#30109"
msgid "Set the turbo pulse speed for the Turbo B and Turbo A buttons."
msgstr "Nastaví rýchlosť turbo impulzu pre tlačidlá Turbo B a Turbo A."

msgctxt "#30110"
msgid "Emulation Hacks"
msgstr "Emulačné hacky"

msgctxt "#30111"
msgid "Change processor overclocking and emulation accuracy settings affecting low-level performance and compatibility."
msgstr "Zmeňte nastavenia pretaktovania procesora a presnosti emulácie ovplyvňujúce nízkoúrovňový výkon a kompatibilitu."

msgctxt "#30112"
msgid "Remove 8-sprites-per-scanline hardware limit."
msgstr "Odstrániť hardvérový limit 8 spritov na riadok."

msgctxt "#30114"
msgid "RAM values on power up. Some games rely on initial RAM values for random number generation as an example."
msgstr "Hodnoty RAM pri zapnutí. Niektoré hry sa spoliehajú na počiatočné hodnoty RAM, napríklad pre generovanie náhodných čísel."

