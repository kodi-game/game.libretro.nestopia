msgid "Mouse"
msgstr "Mysz"

msgctxt "#30101"
msgid "Pointer"
msgstr "Wskaźnik"

msgctxt "#30102"
msgid "Set the range for the Arkanoid paddle."
msgstr "Ustawia zakres paletki Arkanoid."

msgctxt "#30103"
msgid "Combined range of both controllers (32-166)"
msgstr "Łączny zakres obu kontrolerów (32-166)"

msgctxt "#30104"
msgid "Arkanoid I controller range (46-166)"
msgstr "Zakres kontrolera Arkanoid I (46-166)"

msgctxt "#30105"
