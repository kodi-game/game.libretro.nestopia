msgctxt "#30095"
msgid "Input"
msgstr "Vstup"

msgctxt "#30096"
msgid "Change input devices and other input related settings."
msgstr "Změnit vstupní zařízení a další nastavení související se vstupem."

msgctxt "#30097"
msgid "Manually select a 4 Player Adapter if needed. Some games will not recognize the adapter correctly through the NstDatabase.xml database, this option should help fix that."
msgstr "V případě potřeby ručně vyberte adaptér pro 4 hráče. Některé hry adaptér správně nerozpoznají prostřednictvím databáze NstDatabase.xml; tato volba by měla pomoci problém opravit."

msgctxt "#30098"
msgid "Rotate the A/B/X/Y buttons clockwise."
msgstr "Otočit tlačítka A/B/X/Y po směru hodinových ručiček."

msgctxt "#30099"
msgid "Select the device you wish to use for the Arkanoid paddle."
msgstr "Vyberte zařízení, které chcete použít pro ovladač Arkanoid."

msgctxt "#30100"
msgid "Mouse"
msgstr "Myš"

msgctxt "#30101"
msgid "Pointer"
msgstr "Ukazatel"

msgctxt "#30102"
msgid "Set the range for the Arkanoid paddle."
msgstr "Nastavte rozsah ovladače Arkanoid."

msgctxt "#30103"
msgid "Combined range of both controllers (32-166)"
msgstr "Kombinovaný rozsah obou ovladačů (32–166)"

msgctxt "#30104"
msgid "Arkanoid I controller range (46-166)"
msgstr "Rozsah ovladače Arkanoid I (46–166)"

msgctxt "#30105"
msgid "Arkanoid II controller range (32-153)"
msgstr "Rozsah ovladače Arkanoid II (32–153)"

msgctxt "#30106"
