msgctxt "#30036"
msgid "Change system region and other hardware-related settings."
msgstr "Změnit region systému a další nastavení související s hardwarem."

msgctxt "#30037"
msgid "'Auto' will use the NstDatabase.xml database file for region autodetection. If there is no database present, it will default to NTSC."
msgstr "„Automaticky“ použije databázový soubor NstDatabase.xml k automatickému určení regionu. Pokud databáze neexistuje, ve výchozím nastavení se použije NTSC."

