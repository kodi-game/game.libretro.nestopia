msgctxt "#30043"
msgid "Automatically insert first FDS disk on reset."
msgstr "Tự động chèn đĩa FDS đầu tiên khi reset."

msgctxt "#30044"
msgid "Define which format will be used by savefiles generated for FDS games. Based on the format chosen, FDS savefiles might be used interchangeably with other cores and standalone emulators. It is recommended to use with caution, as improper handling may cause undesired overwrites, or deletion of the existing saves."
msgstr "Xác định định dạng sẽ được sử dụng cho tệp lưu của các trò chơi FDS. Tùy theo định dạng được chọn, tệp lưu có thể dùng chung với các lõi khác hoặc trình giả lập độc lập.Khuyến cáo sử dụng cẩn thận, vì thao tác sai có thể ghi đè hoặc xóa nhầm dữ liệu lưu hiện có."

msgctxt "#30045"
msgid "SAV + UPS (Default)"
msgstr "SAV + UPS (Mặc định)"

msgctxt "#30046"
msgid "UPS (Standalone Nestopia)"
msgstr "UPS (trình giả lập Nestopia độc lập)"

msgctxt "#30047"
msgid "IPS (Mesen)"
msgstr "IPS (trình giả lập Mesen)"

msgctxt "#30048"
msgid "Video"
msgstr ""

msgctxt "#30049"
msgid "Change aspect ratio, display cropping, color palette and video filter settings."
msgstr "Thay đổi tỷ lệ khung hình, cắt hiển thị, bảng màu và các cài đặt bộ lọc video."

msgctxt "#30050"
msgid "Enable Blargg NTSC filters."
msgstr "Bật bộ lọc NTSC của Blargg."

msgctxt "#30051"
msgid "Composite Video"
msgstr "Tín hiệu Video tổng hợp"

msgctxt "#30052"
msgid "S-Video"
msgstr "Tín hiệu S-Video"

msgctxt "#30053"
msgid "RGB SCART"
msgstr "Cáp SCART tín hiệu RGB"

msgctxt "#30054"
msgid "Monochrome"
msgstr "Đơn sắc"

msgctxt "#30055"
msgid "Color palette to be used. If 'Custom' is selected, the palette used will be taken from the 'custom.pal' file placed in the RetroArch System/BIOS directory."
msgstr "Bảng màu sẽ được sử dụng. Nếu chọn 'Tùy chỉnh', bảng màu sẽ lấy từ tệp 'custom.pal' đặt trong thư mục System/BIOS của RetroArch."

