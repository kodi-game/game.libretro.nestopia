msgstr "NES Classic FBX (cố định)"

msgctxt "#30070"
msgid "Restored Wii VC"
msgstr "Khôi phục Wii VC"

msgctxt "#30071"
msgid "Wii Virtual Console"
msgstr "Dịch vụ game cổ điển trên Wii"

msgctxt "#30072"
