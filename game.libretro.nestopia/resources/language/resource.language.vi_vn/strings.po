msgid "System"
msgstr "Hệ thống"

msgctxt "#30036"
msgid "Change system region and other hardware-related settings."
msgstr "Thay đổi vùng hệ thống và các cài đặt phần cứng khác."

msgctxt "#30037"
msgid "'Auto' will use the NstDatabase.xml database file for region autodetection. If there is no database present, it will default to NTSC."
msgstr ""

